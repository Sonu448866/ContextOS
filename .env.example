# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.euaijy3.mongodb.net/contextos?retryWrites=true&w=majority

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Frontend API URL
VITE_API_URL=http://localhost:5000/api

# AI Service Configuration (Groq / Gemini / OpenAI)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
AI_MODEL=openai/gpt-oss-20b
AI_API_KEY=gsk_...
GEMINI_API_KEY=AQ....

# Qdrant Vector Database (RAG)
QDRANT_URL=https://<your-cluster>.qdrant.io
QDRANT_API_KEY=...
QDRANT_COLLECTION=knowledge
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=384

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# Upload & Rate Limiting
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Context Gap Detection Thresholds
STALE_TASK_DAYS=14
