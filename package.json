{
  "name": "contextos",
  "version": "1.0.0",
  "description": "ContextOS — AI-Powered Knowledge & Context Transfer Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "vercel-build": "npm run build",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "test": "npm run test --prefix server",
    "seed": "npm run seed --prefix server"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mammoth": "^1.8.0",
    "mongoose": "^8.5.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^3.2.14",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "context-transfer",
    "knowledge-management",
    "ai",
    "tasks",
    "contextos"
  ],
  "author": "ContextOS Team",
  "license": "MIT"
}
